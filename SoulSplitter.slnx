    <File Path="resources/soulsplitter.png" />
    <File Path="resources/soulsplitter1.png" />
    <File Path="resources/soulsplitter2.png" />
    <File Path="resources/soulsplitter3.png" />
    <File Path="resources/soulsplitter4.png" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitignore" />
    <File Path="CapitaineToinon - COPYING" />
    <File Path="Directory.Build.props" />
    <File Path="LICENSE" />
    <File Path="qodana.yaml" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/SoulSplitter.Cli/SoulSplitter.Cli.csproj">
      <Platform Project="x64" />
    </Project>
    <Project Path="src/SoulSplitter.CliTimer/SoulSplitter.CliTimer.csproj">
