    <File Path="Components/MaterialDesignThemes.Wpf.dll" />
    <File Path="Components/MaterialDesignThemes.Wpf.xml" />
    <File Path="Components/Microsoft.Xaml.Behaviors.dll" />
    <File Path="Components/SoulSplitter.Plugin.dll" />
    <File Path="Components/soulsplitter.soulmemory-rs.launcher.x64.exe" />
    <File Path="Components/soulsplitter.soulmemory-rs.launcher.x86.exe" />
    <File Path="Components/SoulSplitter.SoulMemory.dll" />
    <File Path="Components/soulsplitter.soulmemory_rs.x64.dll" />
    <File Path="Components/soulsplitter.soulmemory_rs.x86.dll" />
    <File Path="Components/soulsplitter.soulmods.x64.dll" />
    <File Path="Components/soulsplitter.soulmods.x86.dll" />
    <File Path="Components/Updates.xml" />
